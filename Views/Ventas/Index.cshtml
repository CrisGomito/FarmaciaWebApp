@model IEnumerable<FarmaciaWebApp.Models.Venta>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Historial de Ventas Realizadas</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-cart-plus"></i> Nueva Venta</a>
</div>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID Venta</th>
            <th>Fecha y Hora</th>
            <th>Total General</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td><strong class="text-success">@item.Total.ToString("C")</strong></td>
            </tr>
        }
    </tbody>
</table>