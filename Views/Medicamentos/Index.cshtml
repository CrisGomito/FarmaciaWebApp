@model IEnumerable<FarmaciaWebApp.Models.Medicamento>
@{
    ViewData["Title"] = "Medicamentos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Medicamentos</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Medicamento</a>
</div>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Proveedor</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio.ToString("C")</td>
                <td>
                    @if (item.Stock <= 5)
                    {
                        <span class="badge bg-danger">@item.Stock (Bajo)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@item.Stock</span>
                    }
                </td>
                <td>@(item.Proveedor?.Nombre ?? "Sin Proveedor")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white"><i class="bi bi-eye"></i> Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>